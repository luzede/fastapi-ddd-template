# Database (DB__ prefix maps to Settings.db)
DB__HOST=localhost
DB__PORT=5432
DB__USERNAME=postgres
DB__PASSWORD=change-me
DB__NAME=app
DB__ECHO=false

# Server (APP__ prefix maps to Settings.app)
APP__HOST=127.0.0.1
APP__PORT=8000

# JSON array, not comma-separated
APP__CORS_ORIGINS=["http://localhost:3000"]
