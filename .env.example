# Database (DB__ prefix maps to Settings.db)
DB__HOST=localhost
DB__PORT=5432
DB__USERNAME=postgres
DB__PASSWORD=change-me
DB__NAME=app
DB__ECHO=false
DB__POOL_SIZE=10
DB__POOL_RECYCLE=3600
DB__POOL_PRE_PING=true
DB__POOL_TIMEOUT=30
DB__MAX_OVERFLOW=10


# Server (SERVER__ prefix maps to Settings.server)
SERVER__HOST=127.0.0.1
SERVER__PORT=8000
# JSON array, not comma-separated
SERVER__CORS_ORIGINS=["http://localhost:3000"]

# OpenTelemetry. Logs always go to the terminal; set the endpoint to also export
# logs and traces over OTLP/HTTP (e.g. to an OpenTelemetry Collector).
# OTEL_SERVICE_NAME=fastapi-ddd-template
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Auth (AUTH__ prefix maps to Settings.auth; nested groups use a second "__")
# REQUIRED. >= 32 chars. Encrypts JWT private keys at rest and keys verification tokens.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__SECRET=change-me-to-a-random-string-of-at-least-32-characters

