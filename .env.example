# Database (DB__ prefix maps to Settings.db)
DB__HOST=localhost
DB__PORT=5432
DB__USERNAME=postgres
DB__PASSWORD=change-me
DB__NAME=app
DB__ECHO=false

# Server (SERVER__ prefix maps to Settings.server)
SERVER__HOST=127.0.0.1
SERVER__PORT=8000

# JSON array, not comma-separated
SERVER__CORS_ORIGINS=["http://localhost:3000"]

# Auth (AUTH__ prefix maps to Settings.auth)
# Session token TTL in seconds (7 days)
AUTH__SESSION_TTL_SECONDS=604800
# Email verification code TTL in seconds (5 minutes)
AUTH__VERIFICATION_CODE_TTL_SECONDS=300
