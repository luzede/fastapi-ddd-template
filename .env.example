# ==============================================================================
# FastAPI DDD Template - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and update the values for your environment:
#   cp .env.example .env
#
# SECURITY WARNING:
# - NEVER commit the active '.env' file or any real production secrets to git.
# - Production secrets should be injected via environment variables or a secrets
#   manager (e.g. AWS Secrets Manager, HashiCorp Vault, Kubernetes Secrets).
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ==============================================================================

# Application deployment environment.
# Allowed values: development | staging | production | testing
# Default: development
#
# Production behavior:
# - Disables interactive OpenAPI documentation (/docs, /redoc, /openapi.json).
# - Enables structured JSON logging with UTC timestamps to stdout.
# - Disables Uvicorn hot-reload and enables multi-worker concurrency.
ENVIRONMENT=production

# Logging level filter.
# Allowed values: DEBUG | INFO | WARNING | ERROR | CRITICAL (case-insensitive)
# Default: Automatically resolved based on ENVIRONMENT:
#   - production / staging: INFO
#   - development: DEBUG
#   - testing: WARNING
# Leave commented out to use the environment default, or uncomment to override.
# LOG_LEVEL=INFO


# ==============================================================================
# 2. SERVER & HTTP (SERVER__ prefix maps to Settings.server)
# ==============================================================================

# Network interface host address to bind the HTTP server to.
# - '0.0.0.0' binds to all interfaces (standard for Docker / Kubernetes / cloud).
# - '127.0.0.1' or 'localhost' restricts access to loopback only (local development).
# Default: localhost
SERVER__HOST=0.0.0.0

# TCP port number to listen on.
# Default: 8000
SERVER__PORT=8000

# Number of worker processes to spawn (integer >= 1).
# Production rule of thumb: (2 x $NUM_CPU_CORES) + 1, or adjust for container CPU limits.
# Note: In development (ENVIRONMENT=development), reload is enabled and workers is forced to 1.
# Default: 1
SERVER__WORKERS=4

# Allowed CORS origins as a valid JSON array of string URLs.
# CRITICAL: Must be a valid JSON array format, NOT comma-separated strings!
# Examples:
#   Development: ["http://localhost:3000", "http://127.0.0.1:3000"]
#   Production:  ["https://app.example.com", "https://admin.example.com"]
# Default: ["http://localhost:3000"]
SERVER__CORS_ORIGINS=["https://app.example.com"]


# ==============================================================================
# 3. DATABASE (DB__ prefix maps to Settings.db)
# ==============================================================================
# Async PostgreSQL connection settings (uses postgresql+asyncpg driver).

# Database hostname or IP address.
# Production: Managed database endpoint (e.g., RDS, Cloud SQL, Aurora, internal DNS).
# Default: localhost
DB__HOST=postgres.internal

# Database port number.
# Default: 5432
DB__PORT=5432

# Database user name.
# REQUIRED.
DB__USERNAME=app_user

# Database user password.
# REQUIRED.
DB__PASSWORD=replace-with-a-strong-production-database-password

# Database catalog/database name.
# REQUIRED.
DB__NAME=app_production

# Log all generated SQL queries to stdout (SQLAlchemy engine echo).
# CRITICAL: Must be 'false' in production for performance and to avoid logging sensitive data.
# Default: false
DB__ECHO=false

# --- Connection Pooling Settings ---

# Number of steady-state connections to keep open in the pool per worker process.
# Total connections to DB = SERVER__WORKERS * (DB__POOL_SIZE + DB__MAX_OVERFLOW).
# Ensure your PostgreSQL instance 'max_connections' can accommodate this total!
# Default: 20
DB__POOL_SIZE=20

# Maximum burst/overflow connections permitted beyond DB__POOL_SIZE under peak load.
# Default: 10
DB__MAX_OVERFLOW=10

# Validate connection liveness (SELECT 1) before leasing from pool.
# Prevents stale connection drops caused by firewalls, idle TCP timeouts, or database restarts.
# Default: true
DB__POOL_PRE_PING=true

# Maximum connection lifetime in seconds before recycling/refreshing it.
# Prevents memory leaks and stale backend connections behind load balancers.
# Default: 1800 (30 minutes)
DB__POOL_RECYCLE=1800

# Seconds to wait for an available connection from the pool before raising a TimeoutError.
# Default: 30
DB__POOL_TIMEOUT=30


# ==============================================================================
# 4. AUTHENTICATION & SECURITY (AUTH__ prefix maps to Settings.auth)
# ==============================================================================

# Master application secret key.
# REQUIRED. Must be AT LEAST 32 characters in length.
# Used for encrypting sensitive cryptographic tokens and internal keys at rest.
#
# Generate a cryptographically secure key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   or: openssl rand -base64 48
AUTH__SECRET=replace-with-a-random-secret-key-at-least-32-chars-long

# Secret key used for signing and verifying JWT access tokens.
# REQUIRED. Must be AT LEAST 32 characters in length.
#
# Generate a distinct cryptographically secure key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   or: openssl rand -base64 48
AUTH__JWT_SECRET=replace-with-a-distinct-jwt-secret-key-at-least-32-chars

# JWT signing algorithm.
# Supported: HS256
# Default: HS256
AUTH__JWT_ALGORITHM=HS256

# JWT token expiration duration.
# Formats accepted: human-readable strings like '15m', '1h', '7d', '30s', or integer seconds.
# Recommended for production: '15m' to '1h' (short-lived access tokens).
# Default: 1h (60 minutes)
AUTH__JWT_EXPIRES_IN=1h

# Minimum password length enforced during user sign-up and password reset.
# Default: 8
AUTH__PASSWORD_MIN_LENGTH=8

# Maximum password length accepted (guards against DoS via compute-heavy Argon2id hashing).
# Default: 128
AUTH__PASSWORD_MAX_LENGTH=128


# ==============================================================================
# 5. OBSERVABILITY & OPENTELEMETRY
# ==============================================================================

# Service name reported in OpenTelemetry spans, metrics, and logs.
# Default: fastapi-ddd-template
OTEL_SERVICE_NAME=fastapi-ddd-template

# Base OTLP/HTTP collector endpoint (e.g. OpenTelemetry Collector, Grafana Tempo/Loki, Datadog).
# When configured, traces are exported to '${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/traces'
# and logs are exported to '${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/logs'.
# If unset or commented out, traces/logs stay local and are only written to stdout.
# Examples:
#   Local collector:       http://localhost:4318
#   Container collector:   http://otel-collector:4318
#   Production collector:  https://otlp.internal:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
