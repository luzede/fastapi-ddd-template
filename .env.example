# Database (DB__ prefix maps to Settings.db)
DB__HOST=localhost
DB__PORT=5432
DB__USERNAME=postgres
DB__PASSWORD=change-me
DB__NAME=app
DB__ECHO=false

# Server (SERVER__ prefix maps to Settings.server)
SERVER__HOST=127.0.0.1
SERVER__PORT=8000

# JSON array, not comma-separated
SERVER__CORS_ORIGINS=["http://localhost:3000"]

# Auth (AUTH__ prefix maps to Settings.auth; nested groups use a second "__")
# REQUIRED. >= 32 chars. Encrypts JWT private keys at rest and keys verification tokens.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Public origin of this API; default JWT issuer/audience
AUTH__BASE_URL=http://localhost:8000

# Sessions (better-auth `session`)
AUTH__SESSION__TTL_SECONDS=604800
AUTH__SESSION__UPDATE_AGE_SECONDS=86400
AUTH__SESSION__FRESH_AGE_SECONDS=86400
AUTH__SESSION__COOKIE_NAME=session_token
# Set to false only for plain-http local development
AUTH__SESSION__COOKIE_SECURE=true
AUTH__SESSION__COOKIE_SAME_SITE=lax

# Email + password (better-auth `emailAndPassword`)
AUTH__EMAIL_PASSWORD__REQUIRE_EMAIL_VERIFICATION=false
AUTH__EMAIL_PASSWORD__SEND_VERIFICATION_ON_SIGN_UP=true
AUTH__EMAIL_PASSWORD__PASSWORD_MIN_LENGTH=8
AUTH__EMAIL_PASSWORD__PASSWORD_MAX_LENGTH=128
AUTH__EMAIL_PASSWORD__EMAIL_VERIFICATION_TTL_SECONDS=3600
AUTH__EMAIL_PASSWORD__PASSWORD_RESET_TTL_SECONDS=3600
AUTH__EMAIL_PASSWORD__RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Admin plugin
AUTH__ADMIN__DEFAULT_ROLE=user
# JSON arrays
AUTH__ADMIN__ADMIN_ROLES=["admin"]
AUTH__ADMIN__ADMIN_USER_IDS=[]
AUTH__ADMIN__IMPERSONATION_SESSION_TTL_SECONDS=3600
AUTH__ADMIN__ALLOW_IMPERSONATING_ADMINS=false

# JWT plugin
AUTH__JWT__EXPIRATION_SECONDS=900
AUTH__JWT__ALGORITHM=EdDSA
# Leave unset to disable rotation
# AUTH__JWT__ROTATION_INTERVAL_SECONDS=2592000
AUTH__JWT__GRACE_PERIOD_SECONDS=2592000

# API key plugin
AUTH__API_KEY__HEADER_NAMES=["x-api-key"]
AUTH__API_KEY__DEFAULT_KEY_LENGTH=64
AUTH__API_KEY__RATE_LIMIT_ENABLED=true
AUTH__API_KEY__RATE_LIMIT_TIME_WINDOW_MS=86400000
AUTH__API_KEY__RATE_LIMIT_MAX=10
AUTH__API_KEY__ENABLE_SESSION_FOR_API_KEYS=true
